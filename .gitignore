### Rust template
# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

### Project-specific ignores
# Generated network-security data
/network-security.data

# Vendored source trees unpacked during session 04
/sessions/04/curl/curl-8.20.0/
/sessions/04/which/which-2.23/

# Build output directories from local C/C++/Rust experiments
/sessions/*/bin/

# Standalone examples compiled in place, e.g. rustc sessions/13/01_helloworld.rs
/sessions/[0-9][0-9]/[0-9][0-9]*_*
!/sessions/[0-9][0-9]/[0-9][0-9]*_*.*
